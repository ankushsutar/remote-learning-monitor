# ==============================================================================
# AEGIS TELEMETRY PLATFORM: CENTRALIZED CONFIGURATION (.env)
# Single source of truth for Backend, Web Dashboard, Mobile Client & Infrastructure
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GLOBAL RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. INGESTION BACKEND API (services/backend)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Security & Rotating Device Tokens
JWT_SECRET=antigravity-production-telemetry-key-2026
JWT_EXPIRY=7d

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / TimescaleDB)
# ------------------------------------------------------------------------------
# If PostgreSQL is not reachable, the backend automatically fails over to
# a resilient in-memory storage engine with identical hypertable queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry_db
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 4. REDIS DEDUPLICATION PIPELINE (services/backend)
# ------------------------------------------------------------------------------
# High-throughput batch deduplication cache (falls back to memory LRU if offline)
REDIS_URL=redis://localhost:6379
REDIS_DEDUP_TTL_SEC=86400

# ------------------------------------------------------------------------------
# 5. WEB MANAGEMENT DASHBOARD (apps/dashboard)
# ------------------------------------------------------------------------------
DASHBOARD_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 6. MOBILE CLIENT (apps/mobile)
# ------------------------------------------------------------------------------
# Android Emulator uses 10.0.2.2 to reach host machine's localhost:4000
# For physical devices over Wi-Fi, change to http://<YOUR_LAN_IP>:4000
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:4000
EXPO_PUBLIC_DEFAULT_STUDENT_CODE=STU-94021

# ------------------------------------------------------------------------------
# 7. TELEMETRY & COMPLIANCE THRESHOLDS
# ------------------------------------------------------------------------------
# Periodic background sync interval in minutes
TELEMETRY_SYNC_INTERVAL_MIN=15

# Sync delay threshold before flagging device with Tamper Alert (hours)
TAMPER_SYNC_TIMEOUT_HOURS=2

# High-bandwidth streaming/gaming alert threshold during class hours (MB)
CLASSROOM_BANDWIDTH_SPIKE_MB=15
