{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "usage-telemetry": [
        "modules/usage-telemetry"
      ]
    }
  },
  "include": [
    "src/**/*",
    "modules/**/*",
    "plugins/**/*"
  ],
  "extends": "expo/tsconfig.base"
}
