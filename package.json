{
  "name": "student-telemetry-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/mobile/modules/*",
    "services/*"
  ],
  "scripts": {
    "backend:dev": "npm --prefix services/backend run dev",
    "dashboard:dev": "npm --prefix apps/dashboard run dev",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:dev": "./scripts/mobile-dev.sh",
    "mobile:build": "./scripts/build-mobile.sh",
    "mobile:bundle": "./scripts/build-bundle.sh",
    "seed": "npm --prefix services/backend run seed"
  }
}
