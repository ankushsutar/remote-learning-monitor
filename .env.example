# ==============================================================================
# AEGIS TELEMETRY PLATFORM: ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and customize values for your deployment environment.
# ==============================================================================

# --- GLOBAL RUNTIME ENVIRONMENT ---
NODE_ENV=development
LOG_LEVEL=info

# --- INGESTION BACKEND API (services/backend) ---
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-your-cryptographic-secret-key-in-production
JWT_EXPIRY=7d

# --- DATABASE CONFIGURATION (PostgreSQL / TimescaleDB) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry_db
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000

# --- REDIS DEDUPLICATION PIPELINE (services/backend) ---
REDIS_URL=redis://localhost:6379
REDIS_DEDUP_TTL_SEC=86400

# --- WEB MANAGEMENT DASHBOARD (apps/dashboard) ---
DASHBOARD_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# --- MOBILE CLIENT (apps/mobile) ---
# Android Emulator uses 10.0.2.2. For physical Android devices, use your local network IP (e.g., http://192.168.1.100:4000)
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:4000
EXPO_PUBLIC_DEFAULT_STUDENT_CODE=STU-94021

# --- TELEMETRY & COMPLIANCE THRESHOLDS ---
TELEMETRY_SYNC_INTERVAL_MIN=15
TAMPER_SYNC_TIMEOUT_HOURS=2
CLASSROOM_BANDWIDTH_SPIKE_MB=15
